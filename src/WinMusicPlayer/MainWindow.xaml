<Window x:Class="WinMusicPlayer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:WinMusicPlayer.Views"
        Title="音乐播放器"
        Width="1080" Height="700"
        MinWidth="880" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Foreground="{StaticResource TextBrush}"
        TextOptions.TextFormattingMode="Ideal">

    <Grid x:Name="RootLayer">
        <!-- 背景层单独一层，透明度只作用于它，文字和控件始终 100% 不透明 -->
        <Rectangle x:Name="BackdropLayer" Fill="#FF1A1A1E" Opacity="1" />

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 顶栏 -->
            <Grid Grid.Row="0" Margin="14,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Style="{StaticResource IconButton}"
                        Command="{Binding ChooseFolderCommand}"
                        ToolTip="选择音乐文件夹">
                    <StackPanel Orientation="Horizontal">
                        <!-- 图标比文字略大一点才压得住，但不能沿用样式里 16 的字号，
                             那个尺寸是给纯图标按钮定的，和文字并排会显得笨重 -->
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8B7;"
                                   FontSize="15" VerticalAlignment="Center" />
                        <!-- 必须显式指定正文字体：父级 IconButton 的图标字体没有 CJK 字形 -->
                        <TextBlock Text="选择文件夹" Margin="7,0,0,0"
                                   FontFamily="{StaticResource UiFont}" FontSize="13"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button Grid.Column="1" Style="{StaticResource IconButton}"
                        Content="&#xE72C;" Margin="4,0,0,0"
                        Command="{Binding RefreshCommand}"
                        Visibility="{Binding HasFolder, Converter={StaticResource BoolToVisibility}}"
                        ToolTip="重新扫描该文件夹，同步新增或删除的歌曲（不打断播放）" />

                <TextBlock Grid.Column="2" Margin="10,0"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           TextTrimming="CharacterEllipsis"
                           Text="{Binding FolderPath}"
                           ToolTip="{Binding FolderPath}" />

                <TextBlock Grid.Column="3" VerticalAlignment="Center"
                           Margin="0,0,8,0"
                           Foreground="{StaticResource SecondaryTextBrush}">
                    <Run Text="共 " /><Run Text="{Binding LibraryCount, Mode=OneWay}" /><Run Text=" 首" />
                </TextBlock>

                <Button Grid.Column="4" Style="{StaticResource IconButton}"
                        Content="&#xE713;" Click="OnOpenSettings"
                        ToolTip="设置" />
            </Grid>

            <Border Grid.Row="1" Height="1" Background="{StaticResource SeparatorBrush}" />

            <!-- 错误提示条 -->
            <Border Grid.Row="2" Background="#33FF9500" Padding="14,8"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" FontFamily="{StaticResource IconFont}"
                               Text="&#xE7BA;" Foreground="Orange" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Margin="8,0" TextWrapping="Wrap"
                               Text="{Binding ErrorMessage}" VerticalAlignment="Center" />
                    <Button Grid.Column="2" Style="{StaticResource IconButton}"
                            Content="&#xE711;" Click="OnDismissError" />
                </Grid>
            </Border>

            <!-- 主体：左列表 + 右正在播放 -->
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="340" MinWidth="260" MaxWidth="480" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" MinWidth="360" />
                </Grid.ColumnDefinitions>

                <views:TrackListView Grid.Column="0" />

                <GridSplitter Grid.Column="1" Width="1"
                              HorizontalAlignment="Stretch"
                              Background="{StaticResource SeparatorBrush}" />

                <views:NowPlayingView Grid.Column="2" />
            </Grid>

            <Border Grid.Row="4" Height="1" Background="{StaticResource SeparatorBrush}" />

            <views:ControlsBar Grid.Row="5" />
        </Grid>

        <!-- 设置浮层 -->
        <Popup x:Name="SettingsPopup" Placement="Center" StaysOpen="False" AllowsTransparency="True">
            <views:SettingsPanel />
        </Popup>
    </Grid>
</Window>
