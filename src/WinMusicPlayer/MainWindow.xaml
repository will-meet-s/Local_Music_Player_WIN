<Window
    x:Class="WinMusicPlayer.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:WinMusicPlayer.Views">

    <Grid x:Name="RootLayer">
        <!-- 背景层单独一层，透明度只作用于它；文字和控件始终 100% 不透明 -->
        <Rectangle x:Name="BackdropLayer" Fill="#FF1A1A1E"
                   Opacity="{x:Bind ViewModel.BackgroundOpacity, Mode=OneWay}" />

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- DEF-004：自绘标题栏，和内容区共用同一层亚克力/底色层，不要放任何可交互控件——
                 整块都靠 SetTitleBar 交给系统当拖动区域 -->
            <Grid x:Name="AppTitleBar" Grid.Row="0" Height="32" Background="Transparent">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="ms-appx:///Resources/AppIcon.png"
                           Width="16" Height="16" Margin="12,0,0,0"
                           VerticalAlignment="Center" />
                    <TextBlock x:Name="AppTitleText" Text="音乐播放器"
                               Margin="8,0,0,0" FontSize="12"
                               Foreground="{StaticResource TextBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Grid>

            <!-- 顶栏 -->
            <Grid Grid.Row="1" Margin="14,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 选择文件夹、刷新 -->
                <StackPanel x:Name="TopBarLeftHost" Grid.Column="0"
                            Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource IconButton}"
                            Command="{x:Bind ViewModel.ChooseFolderCommand}"
                            ToolTipService.ToolTip="选择音乐文件夹">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8B7;"
                                       FontSize="15" VerticalAlignment="Center" />
                            <TextBlock Text="选择文件夹" Margin="7,0,0,0"
                                       FontFamily="{StaticResource UiFont}" FontSize="13"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource IconButton}"
                            Content="&#xE72C;" Margin="4,0,0,0"
                            Command="{x:Bind ViewModel.RefreshCommand}"
                            Visibility="{x:Bind ViewModel.HasFolder, Mode=OneWay}"
                            ToolTipService.ToolTip="重新扫描该文件夹，同步新增或删除的歌曲（不打断播放）" />
                </StackPanel>

                <!-- 文件夹路径 -->
                <TextBlock Grid.Column="1" Margin="10,0"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           TextTrimming="CharacterEllipsis"
                           Text="{x:Bind ViewModel.FolderPath, Mode=OneWay}"
                           ToolTipService.ToolTip="{x:Bind ViewModel.FolderPath, Mode=OneWay}" />

                <!-- 曲目总数 -->
                <StackPanel x:Name="TopBarRightHost" Grid.Column="2"
                            Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Margin="0,0,8,0"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               Text="{x:Bind views:ViewFormat.TrackCount(ViewModel.LibraryCount), Mode=OneWay}" />
                </StackPanel>

                <Button x:Name="SettingsButton" Grid.Column="3"
                        Style="{StaticResource IconButton}"
                        Content="&#xE713;"
                        ToolTipService.ToolTip="设置">
                    <!-- 点击自动弹出：设置了 Button.Flyout 后 WinUI 会自动接管点击，不需要额外的 Click 处理 -->
                    <Button.Flyout>
                        <Flyout x:Name="SettingsFlyout" Placement="Bottom">
                            <Flyout.FlyoutPresenterStyle>
                                <Style TargetType="FlyoutPresenter">
                                    <Setter Property="Background" Value="{StaticResource SettingsPanelBrush}" />
                                    <Setter Property="BorderBrush" Value="#33FFFFFF" />
                                    <Setter Property="BorderThickness" Value="1" />
                                    <Setter Property="CornerRadius" Value="10" />
                                    <Setter Property="Padding" Value="16" />
                                    <Setter Property="MaxWidth" Value="400" />
                                </Style>
                            </Flyout.FlyoutPresenterStyle>
                            <StackPanel x:Name="SettingsHost" MinWidth="220">
                                <views:SettingsPanel />
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </Grid>

            <Border Grid.Row="2" Height="1" Background="{StaticResource SeparatorBrush}" />

            <!-- 错误提示条 -->
            <Border Grid.Row="3" Background="#33FF9500" Padding="14,8"
                    Visibility="{x:Bind ViewModel.HasError, Mode=OneWay}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" FontFamily="{StaticResource IconFont}"
                               Text="&#xE7BA;" Foreground="Orange" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Margin="8,0" TextWrapping="Wrap"
                               Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" VerticalAlignment="Center" />
                    <Button Grid.Column="2" Style="{StaticResource IconButton}"
                            Content="&#xE711;" Click="OnDismissError"
                            ToolTipService.ToolTip="关闭" />
                </Grid>
            </Border>

            <!-- 提示条（T-008 Notice，和错误提示条分开显示，界面接入方案 v1 §2.2） -->
            <InfoBar x:Name="NoticeBar" Grid.Row="4"
                     Severity="Informational"
                     Message="{x:Bind ViewModel.Notice, Mode=OneWay}"
                     IsOpen="{x:Bind views:ViewFormat.VisibleIfNotEmptyBool(ViewModel.Notice), Mode=OneWay}"
                     CloseButtonClick="OnNoticeCloseButtonClick" />

            <!-- 主体：左栏页签（曲库｜歌单｜播放列表） + 右正在播放/歌词 -->
            <Grid Grid.Row="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="340" MinWidth="260" MaxWidth="480" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" MinWidth="360" />
                </Grid.ColumnDefinitions>

                <!-- UI-1：曲库｜歌单｜播放列表三个页签 -->
                <Grid x:Name="TrackListHost" Grid.Column="0">
                    <views:LibraryPane />
                </Grid>

                <!-- WinUI 没有 GridSplitter，T-001 先放一条固定分隔线 -->
                <Border Grid.Column="1" Width="1" Background="{StaticResource SeparatorBrush}" />

                <!-- T-005：歌词与正在播放 -->
                <Grid x:Name="NowPlayingHost" Grid.Column="2">
                    <views:NowPlayingView />
                </Grid>
            </Grid>

            <Border Grid.Row="6" Height="1" Background="{StaticResource SeparatorBrush}" />

            <!-- T-004：播放控制栏 -->
            <Border x:Name="ControlsHost" Grid.Row="7">
                <views:ControlsBar />
            </Border>
        </Grid>
    </Grid>
</Window>
