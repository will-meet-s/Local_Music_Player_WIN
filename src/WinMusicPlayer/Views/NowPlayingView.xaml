<UserControl x:Class="WinMusicPlayer.Views.NowPlayingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:WinMusicPlayer.Views">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 封面。只看歌词模式下整块隐藏 -->
        <Border Grid.Row="0"
                x:Name="ArtworkHost"
                CornerRadius="10"
                Background="#18FFFFFF"
                Margin="0,0,0,16"
                Visibility="{Binding ShowsArtwork, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <TextBlock FontFamily="{StaticResource IconFont}" FontSize="46"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{StaticResource TertiaryTextBrush}" Text="&#xE8D6;" />
                <Image Source="{Binding PlayingArtwork, Converter={StaticResource ByteArrayToImage}}"
                       Stretch="UniformToFill">
                    <Image.Clip>
                        <RectangleGeometry x:Name="ArtworkClip" RadiusX="10" RadiusY="10" />
                    </Image.Clip>
                </Image>
            </Grid>
        </Border>

        <TextBlock Grid.Row="1" Text="{Binding PlayingTitle}"
                   FontSize="17" FontWeight="SemiBold"
                   TextAlignment="Center" TextTrimming="CharacterEllipsis" />

        <TextBlock Grid.Row="2" Text="{Binding PlayingSubtitle}"
                   Margin="0,3,0,0" TextAlignment="Center"
                   Foreground="{StaticResource SecondaryTextBrush}"
                   TextTrimming="CharacterEllipsis"
                   Visibility="{Binding PlayingSubtitle, Converter={StaticResource NullToVisibility}}" />

        <!-- 文件已从曲库消失的提示 -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0"
                    Visibility="{Binding PlayingTrackMissing, Converter={StaticResource BoolToVisibility}}">
            <TextBlock FontFamily="{StaticResource IconFont}" FontSize="12"
                       Foreground="Orange" Text="&#xE7BA;" VerticalAlignment="Center" />
            <TextBlock Margin="5,0,0,0" FontSize="11"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       Text="文件已不在曲库中，本曲仍可播完" />
        </StackPanel>

        <!-- 歌词。只看封面模式下整块隐藏 -->
        <Grid Grid.Row="4" Margin="0,12,0,0"
              Visibility="{Binding ShowsLyrics, Converter={StaticResource BoolToVisibility}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Height="1" Background="{StaticResource SeparatorBrush}" Margin="0,0,0,10" />
            <views:LyricsView Grid.Row="1" />
        </Grid>

        <!-- 浮在右上角的布局缩略图。不占布局空间，也不抢歌词行的点击 -->
        <views:LayoutThumbnail Grid.Row="0" Grid.RowSpan="5"
                               HorizontalAlignment="Right" VerticalAlignment="Top"
                               Margin="0,-10,-10,0" />
    </Grid>
</UserControl>
