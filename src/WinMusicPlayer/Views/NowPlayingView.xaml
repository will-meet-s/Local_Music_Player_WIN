<UserControl
    x:Class="WinMusicPlayer.Views.NowPlayingView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:WinMusicPlayer.Views">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 封面 -->
        <Border x:Name="ArtworkHost" Grid.Row="0"
                CornerRadius="10" Background="{StaticResource ControlFillBrush}"
                Margin="0,0,0,16" HorizontalAlignment="Center"
                Visibility="{x:Bind ViewModel.ShowsArtwork, Mode=OneWay}">
            <Grid>
                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8D6;"
                           FontSize="46" Foreground="{StaticResource TertiaryTextBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />

                <!-- 背景由后台代码设置为解码出来的封面，没有封面时保持透明，露出上面的占位图标 -->
                <Border x:Name="ArtworkImage" CornerRadius="10" />
            </Grid>
        </Border>

        <TextBlock Grid.Row="1" Text="{x:Bind ViewModel.PlayingTitle, Mode=OneWay}"
                   FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center"
                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" MaxLines="1" />

        <TextBlock Grid.Row="2" Text="{x:Bind ViewModel.PlayingSubtitle, Mode=OneWay}"
                   Margin="0,3,0,0" HorizontalAlignment="Center"
                   Foreground="{StaticResource SecondaryTextBrush}"
                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" MaxLines="1"
                   Visibility="{x:Bind views:ViewFormat.VisibleIfNotEmpty(ViewModel.PlayingSubtitle), Mode=OneWay}" />

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0"
                    Visibility="{x:Bind ViewModel.PlayingTrackMissing, Mode=OneWay}">
            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE7BA;"
                       FontSize="12" Foreground="Orange" VerticalAlignment="Center" />
            <TextBlock Text="文件已不在曲库中，本曲仍可播完" Margin="5,0,0,0"
                       FontSize="11" Foreground="{StaticResource SecondaryTextBrush}"
                       VerticalAlignment="Center" />
        </StackPanel>

        <Grid Grid.Row="4" Margin="0,12,0,0"
              Visibility="{x:Bind ViewModel.ShowsLyrics, Mode=OneWay}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Height="1" Margin="0,0,0,10" Background="{StaticResource SeparatorBrush}" />

            <views:LyricsView Grid.Row="1" />
        </Grid>

        <views:LayoutThumbnail Grid.Row="0" Grid.RowSpan="5"
                               HorizontalAlignment="Right" VerticalAlignment="Top"
                               Margin="0,-10,-10,0" />
    </Grid>
</UserControl>
