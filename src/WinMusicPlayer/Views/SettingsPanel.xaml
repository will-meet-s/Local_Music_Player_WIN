<UserControl
    x:Class="WinMusicPlayer.Views.SettingsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel Width="360">

        <!-- 音频 -->
        <TextBlock Text="音频" Style="{StaticResource SettingsSectionTitle}" />

        <CheckBox IsChecked="{x:Bind ViewModel.ReplayGainEnabled, Mode=TwoWay}">
            <StackPanel>
                <TextBlock Text="音量归一化" />
                <TextBlock Text="按文件里的 ReplayGain 标签补偿响度差异。没打标签的文件不受影响。"
                           FontSize="11" TextWrapping="Wrap" MaxWidth="320"
                           Foreground="{StaticResource SecondaryTextBrush}" />
            </StackPanel>
        </CheckBox>

        <CheckBox Margin="0,10,0,0" IsChecked="{x:Bind ViewModel.ExclusiveOutputEnabled, Mode=TwoWay}">
            <StackPanel>
                <TextBlock Text="独占输出（WASAPI Exclusive）" />
                <TextBlock TextWrapping="Wrap" FontSize="11" MaxWidth="320"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           Text="绕过系统混音器，用文件原生采样率直推设备。独占期间其他程序发不出声，且相邻曲目采样率不同时那一次切歌不是无缝的。" />
            </StackPanel>
        </CheckBox>

        <Border Height="1" Background="{StaticResource SeparatorBrush}" Margin="0,14" />

        <!-- 桌面歌词，留给 T-008 -->
        <StackPanel x:Name="DesktopLyricsSection" />

        <Border Height="1" Background="{StaticResource SeparatorBrush}" Margin="0,14" />

        <!-- 外观，留给 T-007 -->
        <StackPanel x:Name="AppearanceSection" />
    </StackPanel>
</UserControl>
