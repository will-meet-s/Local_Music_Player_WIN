<UserControl
    x:Class="WinMusicPlayer.Views.SonglistListView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:songlists="using:MusicCore.Songlists"
    xmlns:views="using:WinMusicPlayer.Views">

    <!-- 歌单列表页（UI-2，T-003 v7 §2.5）：顶部「新建歌单」，下面是歌单列表，
         每行名称 + 「N 首」，右键「重命名」「删除」，点击进入详情页。 -->
    <Grid Background="{StaticResource SidebarBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Button Grid.Row="0" Margin="10,8" Style="{StaticResource IconButton}" Click="OnNewSonglistClick">
            <StackPanel Orientation="Horizontal">
                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE710;"
                           FontSize="14" VerticalAlignment="Center" />
                <TextBlock Text="新建歌单" Margin="6,0,0,0"
                           FontFamily="{StaticResource UiFont}" FontSize="13"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Button>

        <Grid Grid.Row="1">
            <ListView x:Name="SonglistList"
                      SelectionMode="None"
                      Background="Transparent"
                      ItemsSource="{x:Bind SonglistsVm.Items, Mode=OneWay}"
                      IsItemClickEnabled="True"
                      ItemClick="OnSonglistItemClick">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="songlists:SonglistSummary">
                        <Grid Margin="10,6" RightTapped="OnSonglistItemRightTapped">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="{x:Bind Name}"
                                       MaxLines="1" TextTrimming="CharacterEllipsis"
                                       ToolTipService.ToolTip="{x:Bind Name}"
                                       VerticalAlignment="Center" />

                            <TextBlock Grid.Column="1" Margin="8,0,0,0"
                                       Text="{x:Bind views:ViewFormat.SonglistCount(Count)}"
                                       FontSize="11" Foreground="{StaticResource SecondaryTextBrush}"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- 空态：还没有歌单 -->
            <StackPanel x:Name="EmptyState"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="Collapsed">
                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8FD;"
                           FontSize="36" Foreground="{StaticResource TertiaryTextBrush}"
                           HorizontalAlignment="Center" />
                <TextBlock Text="还没有歌单"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           Margin="0,8,0,0" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
