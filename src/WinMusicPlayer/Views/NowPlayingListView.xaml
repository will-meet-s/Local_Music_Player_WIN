<UserControl
    x:Class="WinMusicPlayer.Views.NowPlayingListView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 播放列表页（UI-1，T-001+T-008 v5 §4.5）：顶部标题，列表用共用的行模板，
         当前播放那一行的图标/强调色由代码后置通过 ContainerContentChanging 覆盖
         （共用模板本身不知道"谁在播放"，见 Themes/TrackRowTemplate.xaml 的注释）。 -->
    <Grid Background="{StaticResource SidebarBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Margin="10,8"
                   Text="{x:Bind ViewModel.NowPlayingHeader, Mode=OneWay}"
                   Foreground="{StaticResource SecondaryTextBrush}" FontSize="12"
                   TextTrimming="CharacterEllipsis" />

        <Border Grid.Row="1" Height="1" Background="{StaticResource SeparatorBrush}" />

        <Grid Grid.Row="2">
            <ListView x:Name="TrackList"
                      SelectionMode="Single"
                      Background="Transparent"
                      ItemsSource="{x:Bind ViewModel.NowPlaying.Items, Mode=OneWay}"
                      ItemTemplate="{StaticResource TrackRowTemplate}"
                      DoubleTapped="OnTrackListDoubleTapped"
                      ContainerContentChanging="OnContainerContentChanging" />

            <!-- 空态：播放列表为空 -->
            <StackPanel x:Name="EmptyState"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="Collapsed">
                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8D6;"
                           FontSize="36" Foreground="{StaticResource TertiaryTextBrush}"
                           HorizontalAlignment="Center" />
                <TextBlock Text="播放列表为空"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           Margin="0,8,0,0" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
