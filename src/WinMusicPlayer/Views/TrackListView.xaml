<UserControl x:Class="WinMusicPlayer.Views.TrackListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lib="clr-namespace:MusicCore.Library;assembly=MusicCore">

    <Grid Background="{StaticResource SidebarBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 搜索 + 排序 -->
        <StackPanel Grid.Row="0" Margin="10,8">
            <Border Background="{StaticResource ControlFillBrush}" CornerRadius="6" Padding="8,5">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" FontFamily="{StaticResource IconFont}"
                               Text="&#xE721;" Foreground="{StaticResource SecondaryTextBrush}"
                               VerticalAlignment="Center" />

                    <Grid Grid.Column="1" Margin="6,0">
                        <TextBox x:Name="SearchBox"
                                 Background="Transparent" BorderThickness="0"
                                 Foreground="{StaticResource TextBrush}"
                                 CaretBrush="{StaticResource TextBrush}"
                                 VerticalContentAlignment="Center"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=120}" />
                        <!-- 占位符：TextBox 为空且未聚焦时显示 -->
                        <TextBlock Text="搜索歌曲、歌手、专辑" IsHitTestVisible="False"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource TertiaryTextBrush}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <Button Grid.Column="2" Style="{StaticResource IconButton}"
                            Content="&#xE711;" Padding="2" FontSize="12"
                            Command="{Binding ClearSearchCommand}"
                            Visibility="{Binding IsFiltering, Converter={StaticResource BoolToVisibility}}"
                            ToolTip="清除搜索" />
                </Grid>
            </Border>

            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <ComboBox Grid.Column="0" Width="104"
                          SelectedValue="{Binding SortOrder}"
                          SelectedValuePath="Tag">
                    <ComboBoxItem Content="文件顺序">
                        <ComboBoxItem.Tag>
                            <lib:TrackSortOrder>FileOrder</lib:TrackSortOrder>
                        </ComboBoxItem.Tag>
                    </ComboBoxItem>
                    <ComboBoxItem Content="歌曲名">
                        <ComboBoxItem.Tag>
                            <lib:TrackSortOrder>Title</lib:TrackSortOrder>
                        </ComboBoxItem.Tag>
                    </ComboBoxItem>
                    <ComboBoxItem Content="歌手名">
                        <ComboBoxItem.Tag>
                            <lib:TrackSortOrder>Artist</lib:TrackSortOrder>
                        </ComboBoxItem.Tag>
                    </ComboBoxItem>
                </ComboBox>

                <!-- 同上：Style 由下面的 Button.Style 提供（BasedOn IconButton） -->
                <Button Grid.Column="1"
                        Margin="4,0,0,0" FontSize="13"
                        Command="{Binding ToggleSortDirectionCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                            <Setter Property="Content" Value="&#xE74A;" />
                            <Setter Property="ToolTip" Value="降序" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SortAscending}" Value="True">
                                    <Setter Property="Content" Value="&#xE74B;" />
                                    <Setter Property="ToolTip" Value="升序" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <TextBlock Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center"
                           FontSize="11" Foreground="{StaticResource SecondaryTextBrush}"
                           Visibility="{Binding IsFiltering, Converter={StaticResource BoolToVisibility}}">
                    <Run Text="匹配 " /><Run Text="{Binding Tracks.Count, Mode=OneWay}" /><Run Text=" 首" />
                </TextBlock>
            </Grid>
        </StackPanel>

        <Border Grid.Row="1" Height="1" Background="{StaticResource SeparatorBrush}" />

        <!-- 曲目列表 -->
        <Grid Grid.Row="2">
            <ListBox x:Name="TrackList"
                     Background="Transparent" BorderThickness="0"
                     ItemsSource="{Binding Tracks}"
                     SelectedIndex="{Binding CurrentIndex, Mode=OneWay}"
                     HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     MouseDoubleClick="OnTrackDoubleClick">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" x:Name="Indicator"
                                       FontFamily="{StaticResource IconFont}" FontSize="11"
                                       Foreground="{StaticResource AccentBrush}"
                                       VerticalAlignment="Center" Text="" />

                            <StackPanel Grid.Column="1" Margin="6,0">
                                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Subtitle}" FontSize="11"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           Visibility="{Binding Subtitle, Converter={StaticResource NullToVisibility}}" />
                            </StackPanel>

                            <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="11"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       Text="{Binding Duration, Converter={StaticResource SecondsToTime}}" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- 空状态 -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Tracks.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <TextBlock FontFamily="{StaticResource IconFont}" FontSize="36"
                           HorizontalAlignment="Center"
                           Foreground="{StaticResource TertiaryTextBrush}" Text="&#xE8D6;" />
                <TextBlock Margin="0,10,0,0" TextAlignment="Center" TextWrapping="Wrap"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           Text="{Binding EmptyMessage}" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
