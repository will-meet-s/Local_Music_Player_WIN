<UserControl
    x:Class="WinMusicPlayer.Views.TrackListView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:WinMusicPlayer.Views">

    <Grid Background="{StaticResource SidebarBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 搜索框、排序控件 -->
        <StackPanel x:Name="SearchSortHost" Grid.Row="0" Margin="10,8">
            <Border Background="{StaticResource ControlFillBrush}" CornerRadius="6" Padding="8,5">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" FontFamily="{StaticResource IconFont}" Text="&#xE721;"
                               Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" />

                    <TextBox x:Name="SearchBox" Grid.Column="1" Margin="6,0"
                             PlaceholderText="搜索歌曲、歌手、专辑"
                             Background="Transparent" BorderThickness="0"
                             TextChanged="OnSearchBoxTextChanged">
                        <TextBox.Resources>
                            <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
                            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                            <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
                            <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                            <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                            <StaticResource x:Key="TextControlPlaceholderForeground" ResourceKey="SecondaryTextBrush" />
                            <StaticResource x:Key="TextControlPlaceholderForegroundPointerOver" ResourceKey="SecondaryTextBrush" />
                            <StaticResource x:Key="TextControlPlaceholderForegroundFocused" ResourceKey="SecondaryTextBrush" />
                        </TextBox.Resources>
                    </TextBox>

                    <Button Grid.Column="2" Style="{StaticResource IconButton}"
                            FontSize="12" Padding="2"
                            Content="&#xE711;"
                            Command="{x:Bind ViewModel.ClearSearchCommand}"
                            Visibility="{x:Bind ViewModel.IsFiltering, Mode=OneWay}"
                            ToolTipService.ToolTip="清除搜索" />
                </Grid>
            </Border>

            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <ComboBox x:Name="SortBox" Grid.Column="0" Width="104" CornerRadius="6"
                          SelectionChanged="OnSortBoxSelectionChanged">
                    <ComboBoxItem Content="文件顺序" />
                    <ComboBoxItem Content="歌曲名" />
                    <ComboBoxItem Content="歌手名" />
                </ComboBox>

                <Button Grid.Column="1" Style="{StaticResource IconButton}"
                        FontSize="13" Margin="4,0,0,0"
                        Content="{x:Bind views:ViewFormat.SortGlyph(ViewModel.SortAscending), Mode=OneWay}"
                        Command="{x:Bind ViewModel.ToggleSortDirectionCommand}"
                        ToolTipService.ToolTip="{x:Bind views:ViewFormat.SortTip(ViewModel.SortAscending), Mode=OneWay}" />

                <!-- T-016：定位当前播放，PlayingTrack 为 null 时不可用 -->
                <Button Grid.Column="2" Style="{StaticResource IconButton}"
                        FontSize="13" Margin="4,0,0,0"
                        Content="&#xE81D;"
                        Click="OnLocateCurrentClick"
                        IsEnabled="{x:Bind ViewModel.CanLocateCurrent, Mode=OneWay}"
                        ToolTipService.ToolTip="定位当前播放" />

                <TextBlock x:Name="MatchCount" Grid.Column="3"
                           HorizontalAlignment="Right" VerticalAlignment="Center"
                           FontSize="11" Foreground="{StaticResource SecondaryTextBrush}"
                           Visibility="{x:Bind ViewModel.IsFiltering, Mode=OneWay}" />
            </Grid>

            <!-- T-016 FR-029 ⑥：当前播放的歌曲被搜索过滤掉了，不自动关闭，用户点 ×、
                 PlayingTrack 变化、或者用户自己改了搜索词时才关闭（代码后置控制） -->
            <InfoBar x:Name="LocateFilteredOutBar" Margin="0,8,0,0"
                     Severity="Informational"
                     Message="当前播放的歌曲不在搜索结果中"
                     IsOpen="False">
                <InfoBar.ActionButton>
                    <Button Content="清空搜索并定位" Click="OnClearSearchAndLocateClick" />
                </InfoBar.ActionButton>
            </InfoBar>
        </StackPanel>

        <Border Grid.Row="1" Height="1" Background="{StaticResource SeparatorBrush}" />

        <Grid Grid.Row="2">
            <!-- Extended 支持 Ctrl/Shift 多选（T-008 §4.5）；SelectedIndex 不再绑 CurrentIndex——
                 代码后置里按选中数量决定要不要跟着 CurrentIndex 走（方案 §2.6 末段：Extended 模式下
                 绑定 SelectedIndex 会把用户的多选冲掉）。 -->
            <ListView x:Name="TrackList"
                      SelectionMode="Extended"
                      Background="Transparent"
                      ItemsSource="{x:Bind ViewModel.Tracks, Mode=OneWay}"
                      ItemTemplate="{StaticResource TrackRowTemplate}"
                      DoubleTapped="OnTrackListDoubleTapped"
                      RightTapped="OnTrackListRightTapped" />

            <!-- 空态：文件夹没选、文件夹里没歌、或者搜不到。显示与否由代码后置控制，见 .xaml.cs -->
            <StackPanel x:Name="EmptyState"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="Collapsed">
                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8D6;"
                           FontSize="36" Foreground="{StaticResource TertiaryTextBrush}"
                           HorizontalAlignment="Center" />
                <TextBlock Text="{x:Bind ViewModel.EmptyMessage, Mode=OneWay}"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           TextWrapping="Wrap" TextAlignment="Center"
                           MaxWidth="220" Margin="0,8,0,0" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
