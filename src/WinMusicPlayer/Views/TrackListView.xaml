<UserControl
    x:Class="WinMusicPlayer.Views.TrackListView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:MusicCore.Models"
    xmlns:views="using:WinMusicPlayer.Views">

    <Grid Background="{StaticResource SidebarBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- T-003：搜索框、排序控件 -->
        <StackPanel x:Name="SearchSortHost" Grid.Row="0" Margin="10,8" />

        <Border Grid.Row="1" Height="1" Background="{StaticResource SeparatorBrush}" />

        <Grid Grid.Row="2">
            <ListView x:Name="TrackList"
                      SelectionMode="Single"
                      Background="Transparent"
                      ItemsSource="{x:Bind ViewModel.Tracks, Mode=OneWay}"
                      SelectedIndex="{x:Bind ViewModel.CurrentIndex, Mode=OneWay}"
                      DoubleTapped="OnTrackListDoubleTapped">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:Track">
                        <Grid Margin="0,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="1" Margin="6,0" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind Title, Mode=OneWay}"
                                           Foreground="{StaticResource TextBrush}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind Subtitle, Mode=OneWay}"
                                           FontSize="11"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           Visibility="{x:Bind views:ViewFormat.VisibleIfNotEmpty(Subtitle), Mode=OneWay}" />
                            </StackPanel>

                            <TextBlock Grid.Column="2" VerticalAlignment="Center"
                                       Text="{x:Bind views:ViewFormat.Time(Duration), Mode=OneWay}"
                                       FontSize="11"
                                       Foreground="{StaticResource SecondaryTextBrush}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- 空态：文件夹没选、文件夹里没歌、或者搜不到。显示与否由代码后置控制，见 .xaml.cs -->
            <StackPanel x:Name="EmptyState"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="Collapsed">
                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8D6;"
                           FontSize="36" Foreground="{StaticResource TertiaryTextBrush}"
                           HorizontalAlignment="Center" />
                <TextBlock Text="{x:Bind ViewModel.EmptyMessage, Mode=OneWay}"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           TextWrapping="Wrap" TextAlignment="Center"
                           MaxWidth="220" Margin="0,8,0,0" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
