<UserControl
    x:Class="WinMusicPlayer.Views.NowPlayingDrawer"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 播放列表抽屉（T-017 v1 §2.2，CR-W1）：叠在 NowPlayingView 上层（在 MainWindow.xaml 里
         排在它后面，保证 Tab 顺序也在后面，W-6），靠 TranslateTransform 从窗口右边缘滑入/滑出。
         两层背景保证不透明度调到最低时，下面的封面和歌词也看不出字（§2.4，⑪）：BlurLayer 在
         代码后置里设成窗口内的 AcrylicBrush，把下面模糊掉；TintLayer 和主窗口的 BackdropLayer
         完全相同，跟着同一个不透明度同步变化。初始 Collapsed + X=340（收起），构造函数按
         IsNowPlayingDrawerOpen 的持久化状态直接设好，不播放动画（⑨）。 -->
    <Grid x:Name="Root"
          HorizontalAlignment="Right"
          Width="340"
          Visibility="Collapsed">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="DrawerTransform" X="340" />
        </Grid.RenderTransform>

        <Rectangle x:Name="BlurLayer" />
        <Rectangle x:Name="TintLayer" Fill="#FF1A1A1E"
                   Opacity="{x:Bind ViewModel.BackgroundOpacity, Mode=OneWay}" />
        <Border BorderThickness="1,0,0,0" BorderBrush="{StaticResource SeparatorBrush}" />

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 标题栏（T-017 v1 §2.2 第 0 行）：NowPlayingListView 自己的头和内容放第 1 行 -->
            <Grid Grid.Row="0" Margin="14,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="播放列表"
                           FontFamily="{StaticResource UiFont}" FontSize="13"
                           VerticalAlignment="Center" />

                <Button Grid.Column="1" Style="{StaticResource IconButton}"
                        FontSize="13" Padding="4"
                        Content="&#xE711;" Click="OnCloseClick"
                        ToolTipService.ToolTip="收起播放列表" />
            </Grid>

            <ContentControl x:Name="ListHost" Grid.Row="1"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch" />
        </Grid>
    </Grid>
</UserControl>
