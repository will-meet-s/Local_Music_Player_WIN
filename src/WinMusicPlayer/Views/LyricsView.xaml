<UserControl x:Class="WinMusicPlayer.Views.LyricsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <ListBox x:Name="LyricList"
                 Background="Transparent" BorderThickness="0"
                 ItemsSource="{Binding Lyrics}"
                 HorizontalContentAlignment="Stretch"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 MouseLeftButtonUp="OnLyricClick">
            <ListBox.Style>
                <Style TargetType="ListBox">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Lyrics.Count}" Value="0">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ListBox.Style>

            <!-- 歌词行不需要选中态，去掉 ListBoxItem 自带的高亮 -->
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Focusable" Value="False" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <ContentPresenter />
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>

            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Text}"
                               TextAlignment="Center" TextWrapping="Wrap"
                               Margin="8,5" Cursor="Hand"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               Tag="{Binding Index}" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- 空状态 -->
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Lyrics.Count}" Value="0">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>

            <TextBlock FontFamily="{StaticResource IconFont}" FontSize="26"
                       HorizontalAlignment="Center"
                       Foreground="{StaticResource TertiaryTextBrush}" Text="&#xE8D2;" />
            <TextBlock Margin="0,8,0,0" Foreground="{StaticResource SecondaryTextBrush}" Text="暂无歌词" />
            <TextBlock Margin="0,4,0,0" FontSize="11" TextAlignment="Center"
                       Foreground="{StaticResource TertiaryTextBrush}"
                       Text="把同名 .lrc 文件放在音频旁边即可显示" />
        </StackPanel>
    </Grid>
</UserControl>
