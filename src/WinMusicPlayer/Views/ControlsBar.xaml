<UserControl x:Class="WinMusicPlayer.Views.ControlsBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel Margin="16,10">

        <!-- 进度 -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="48" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="48" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="{Binding CurrentTimeText}"
                       FontSize="11" TextAlignment="Right" VerticalAlignment="Center"
                       Foreground="{StaticResource SecondaryTextBrush}" />

            <Slider Grid.Column="1" x:Name="ProgressSlider" Margin="10,0"
                    Minimum="0" Maximum="{Binding Duration}"
                    IsMoveToPointEnabled="True"
                    Thumb.DragStarted="OnSeekStarted"
                    Thumb.DragCompleted="OnSeekCompleted"
                    PreviewMouseLeftButtonUp="OnSeekClick" />

            <TextBlock Grid.Column="2" Text="{Binding DurationText}"
                       FontSize="11" VerticalAlignment="Center"
                       Foreground="{StaticResource SecondaryTextBrush}" />
        </Grid>

        <!-- 传输键：上一首 → 播放/暂停 → 下一首 → 停止 → 播放顺序 -->
        <Grid Margin="0,6,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Style="{StaticResource IconButton}" Content="&#xE892;"
                        Command="{Binding PreviousCommand}" ToolTip="上一首" />

                <!-- Style 只能设一次：图标与 ToolTip 随 IsPlaying 变，所以走下面的
                     Button.Style（已 BasedOn PrimaryIconButton），这里不能再写 Style attribute -->
                <Button Margin="10,0"
                        Command="{Binding PlayPauseCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryIconButton}">
                            <Setter Property="Content" Value="&#xF5B0;" />
                            <Setter Property="ToolTip" Value="播放" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                    <Setter Property="Content" Value="&#xF8AE;" />
                                    <Setter Property="ToolTip" Value="暂停" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <Button Style="{StaticResource IconButton}" Content="&#xE893;"
                        Command="{Binding NextCommand}" ToolTip="下一首" />

                <Button Style="{StaticResource IconButton}" Content="&#xE71A;" Margin="10,0,0,0"
                        Command="{Binding StopCommand}" ToolTip="停止" />

                <Button Style="{StaticResource IconButton}" Margin="10,0,0,0"
                        Content="{Binding PlayModeGlyph}"
                        FontFamily="{StaticResource IconFont}"
                        Command="{Binding CyclePlayModeCommand}"
                        ToolTip="{Binding PlayModeName}" />
            </StackPanel>

            <!-- 音量 -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right"
                        VerticalAlignment="Center">
                <TextBlock FontFamily="{StaticResource IconFont}" FontSize="13"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource SecondaryTextBrush}" Text="&#xE767;" />
                <Slider Width="96" Margin="6,0,0,0" VerticalAlignment="Center"
                        Minimum="0" Maximum="1"
                        Value="{Binding Volume, Mode=TwoWay}" />
            </StackPanel>
        </Grid>
    </StackPanel>
</UserControl>
