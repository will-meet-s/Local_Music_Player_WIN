<UserControl
    x:Class="WinMusicPlayer.Views.ControlsBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:WinMusicPlayer.Views">

    <StackPanel Margin="16,10">

        <!-- 进度 -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="48" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="48" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="{x:Bind ViewModel.CurrentTimeText, Mode=OneWay}"
                       FontSize="11" TextAlignment="Right" VerticalAlignment="Center"
                       Foreground="{StaticResource SecondaryTextBrush}" />

            <!-- Value 不绑定，由后台代码控制，见 .xaml.cs -->
            <Slider x:Name="ProgressSlider" Grid.Column="1" Margin="10,0"
                    Minimum="0" Maximum="{x:Bind ViewModel.Duration, Mode=OneWay}"
                    StepFrequency="0.1" IsThumbToolTipEnabled="False" />

            <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.DurationText, Mode=OneWay}"
                       FontSize="11" VerticalAlignment="Center"
                       Foreground="{StaticResource SecondaryTextBrush}" />
        </Grid>

        <!-- 传输按钮和音量 -->
        <Grid Margin="0,6,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Style="{StaticResource IconButton}" Content="&#xE892;"
                        Command="{x:Bind ViewModel.PreviousCommand}"
                        ToolTipService.ToolTip="上一首" />

                <Button Style="{StaticResource PrimaryIconButton}" Margin="10,0"
                        Content="{x:Bind views:ViewFormat.PlayPauseGlyph(ViewModel.IsPlaying), Mode=OneWay}"
                        Command="{x:Bind ViewModel.PlayPauseCommand}"
                        ToolTipService.ToolTip="{x:Bind views:ViewFormat.PlayPauseTip(ViewModel.IsPlaying), Mode=OneWay}" />

                <Button Style="{StaticResource IconButton}" Content="&#xE893;"
                        Command="{x:Bind ViewModel.NextCommand}"
                        ToolTipService.ToolTip="下一首" />

                <Button Style="{StaticResource IconButton}" Content="&#xE71A;" Margin="10,0,0,0"
                        Command="{x:Bind ViewModel.StopCommand}"
                        ToolTipService.ToolTip="停止" />

                <Button Style="{StaticResource IconButton}" Margin="10,0,0,0"
                        Content="{x:Bind ViewModel.PlayModeGlyph, Mode=OneWay}"
                        Command="{x:Bind ViewModel.CyclePlayModeCommand}"
                        ToolTipService.ToolTip="{x:Bind ViewModel.PlayModeName, Mode=OneWay}" />
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal"
                        HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock FontFamily="{StaticResource IconFont}" FontSize="13"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource SecondaryTextBrush}" Text="&#xE767;" />

                <Slider Width="96" Margin="6,0,0,0" VerticalAlignment="Center"
                        Minimum="0" Maximum="1" StepFrequency="0.01" IsThumbToolTipEnabled="False"
                        Value="{x:Bind ViewModel.Volume, Mode=TwoWay}" />
            </StackPanel>
        </Grid>
    </StackPanel>
</UserControl>
