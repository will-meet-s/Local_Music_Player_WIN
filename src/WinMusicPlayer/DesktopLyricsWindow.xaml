<Window
    x:Class="WinMusicPlayer.DesktopLyricsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 几乎全透明但仍能收到鼠标事件，整块可拖动；未锁定时鼠标移入才显示工具条 -->
    <Grid x:Name="Root" Background="#01000000"
          PointerEntered="OnRootPointerEntered"
          PointerExited="OnRootPointerExited"
          PointerPressed="OnRootPointerPressed">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 工具条：锁定 / 字号 / 颜色 / 关闭。始终占位（Opacity 0/1，不用 Visibility），
             悬停显隐不会改变窗口高度，歌词不会被挤动（DEF-008） -->
        <Border x:Name="Toolbar" Grid.Row="0"
                Opacity="0" IsHitTestVisible="False"
                HorizontalAlignment="Center"
                Margin="0,0,0,6" Padding="8,4" CornerRadius="6"
                Background="#CC1E1E22">
            <Border.OpacityTransition>
                <ScalarTransition Duration="0:0:0.12" />
            </Border.OpacityTransition>
            <StackPanel Orientation="Horizontal">
                <Button x:Name="LockButton" Click="OnToggleLock"
                        Style="{StaticResource LyricsToolButton}"
                        ToolTipService.ToolTip="锁定（锁定后鼠标穿透，不再挡住桌面。解锁：鼠标停在歌词上，点出现的小图标）" />
                <Button Click="OnFontSmaller" Style="{StaticResource LyricsToolButton}"
                        Content="&#xE738;" ToolTipService.ToolTip="缩小字号" />
                <Button Click="OnFontLarger" Style="{StaticResource LyricsToolButton}"
                        Content="&#xE710;" ToolTipService.ToolTip="放大字号" />
                <Button Click="OnCycleColor" Style="{StaticResource LyricsToolButton}"
                        Content="&#xE790;" ToolTipService.ToolTip="切换颜色" />
                <Button Click="OnClose" Style="{StaticResource LyricsToolButton}"
                        Content="&#xE711;" ToolTipService.ToolTip="关闭桌面歌词" />
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="1" HorizontalAlignment="Center">
            <!-- 当前行：宿主 Border 和 TextBlock 叠在同一个 Grid 格子里，位置和大小完全重合 -->
            <Grid>
                <Border x:Name="CurrentShadowHost" />
                <TextBlock x:Name="CurrentLine"
                           FontWeight="Bold" TextAlignment="Center" TextWrapping="Wrap" />
            </Grid>

            <!-- 下一行，暗一些 -->
            <Grid Margin="0,4,0,0">
                <Border x:Name="NextShadowHost" />
                <TextBlock x:Name="NextLine"
                           TextAlignment="Center" TextWrapping="Wrap"
                           Opacity="0.65" Foreground="White" />
            </Grid>
        </StackPanel>
    </Grid>
</Window>
