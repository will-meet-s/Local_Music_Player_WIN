<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <UseWPF>true</UseWPF>
    <!-- 托盘图标用 WinForms 的 NotifyIcon，WPF 自身没有对应控件 -->
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Resources\AppIcon.ico</ApplicationIcon>
    <AssemblyName>WinMusicPlayer</AssemblyName>
    <RootNamespace>WinMusicPlayer</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <!-- UseWindowsForms 会把 System.Windows.Forms 和 System.Drawing 加进隐式 using，
         与 WPF 的 System.Windows / System.Windows.Media 大面积同名：Application、
         UserControl、MouseEventArgs、Color、Brush、Point、Size 都会变成 CS0104。
         WinForms 只用在 TrayIcon.cs（托盘 NotifyIcon），那个文件自带显式 using，
         所以这里把隐式项摘掉，其余文件一律按 WPF 解析。 -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MusicCore\MusicCore.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\AppIcon.ico" />
  </ItemGroup>

</Project>
