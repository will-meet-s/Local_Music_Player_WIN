<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 配色：与基线 WPF 版 App.xaml 的键名和取值保持一致，§4 对比度 K-1~K-4 以此为准 -->
    <Color x:Key="AccentColor">#FF5CA8FF</Color>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="TextBrush" Color="#FFF2F2F5" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#FFA0A0AC" />
    <SolidColorBrush x:Key="TertiaryTextBrush" Color="#FF8F8F9B" />
    <SolidColorBrush x:Key="SeparatorBrush" Color="#22FFFFFF" />
    <SolidColorBrush x:Key="ControlFillBrush" Color="#18FFFFFF" />
    <SolidColorBrush x:Key="SidebarBrush" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="PopupBrush" Color="#FF23232A" />

    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <FontFamily x:Key="UiFont">Segoe UI</FontFamily>
    <!-- 覆盖 Fluent 控件的默认字体，保证中文不回退成方框 -->
    <FontFamily x:Key="ContentControlThemeFontFamily">Segoe UI, Microsoft YaHei UI</FontFamily>

    <!-- 让 Fluent 控件（CheckBox、ToggleSwitch 等）的强调色与 K-4 一致 -->
    <Color x:Key="SystemAccentColor">#FF5CA8FF</Color>
    <Color x:Key="SystemAccentColorLight1">#FF5CA8FF</Color>
    <Color x:Key="SystemAccentColorLight2">#FF5CA8FF</Color>
    <Color x:Key="SystemAccentColorLight3">#FF5CA8FF</Color>

    <!-- 图标字体按钮：仅设外观属性，交互状态（悬停/按下）沿用 Fluent 原生 Button 模板 -->
    <Style x:Key="IconButton" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="8,5" />
        <Setter Property="CornerRadius" Value="5" />
    </Style>

    <!-- 播放/暂停主按钮，比其余传输键大一号。契约：以后的主按钮都用它 -->
    <Style x:Key="PrimaryIconButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
        <Setter Property="FontSize" Value="30" />
        <Setter Property="Padding" Value="6" />
    </Style>

    <!-- 设置面板底色，和基线一致，§4 对比度 K-1、K-3 要在同一种背景上比较才公平 -->
    <SolidColorBrush x:Key="SettingsPanelBrush" Color="#F21E1E22" />

    <Style x:Key="SettingsSectionTitle" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

</ResourceDictionary>
