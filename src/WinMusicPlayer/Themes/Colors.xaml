<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 配色：浅色外观（T-018 v1.3 §2.2a，CR-W3）。取值和对比度计算见方案 §2.2a：
         55% 档 + 纯黑壁纸下，浅色 Thin 亚克力叠出的背景比最初估计的 #DCDCE0 暗很多
         （保守估计灰度 80，悲观估计灰度 50），v1.2 的取值在这种情况下对比度不够，
         评审 M-2 按这个更暗的背景重新加深了次要文字、第三级文字、强调色这三项；
         正文 TextBrush 不受影响（改之前就已经 ≥ 4.5） -->
    <Color x:Key="AccentColor">#FF00477F</Color>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="TextBrush" Color="#FF1B1B1F" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#FF45454E" />
    <SolidColorBrush x:Key="TertiaryTextBrush" Color="#FF4A4A54" />
    <SolidColorBrush x:Key="SeparatorBrush" Color="#1F000000" />
    <SolidColorBrush x:Key="ControlFillBrush" Color="#0F000000" />
    <SolidColorBrush x:Key="SidebarBrush" Color="#08000000" />
    <SolidColorBrush x:Key="PopupBrush" Color="#FFFFFFFF" />
    <!-- 底色层、抽屉、退化色三处共用（T-018 §2.1 第 2、3、7、8 项），满足 FR-032 ① 的 R/G/B ≥ 235 -->
    <Color x:Key="BaseBackgroundColor">#FFF7F7F9</Color>
    <SolidColorBrush x:Key="BaseBackgroundBrush" Color="{StaticResource BaseBackgroundColor}" />
    <!-- 播放列表抽屉的背景（T-017 v1.2 §0，CR-W2；T-018 改为浅色）：和主窗口 BackdropLayer
         不透明度调到 100% 时的颜色相同，固定不透明，不随设置面板的不透明度滑块变化 -->
    <SolidColorBrush x:Key="DrawerBackgroundBrush" Color="{StaticResource BaseBackgroundColor}" />
    <!-- 标题栏右上角三个系统按钮用（MainWindow.xaml.cs，T-018 §2.1 第 5 项） -->
    <Color x:Key="TitleBarButtonHoverColor">#0F000000</Color>
    <Color x:Key="TitleBarButtonPressedColor">#1A000000</Color>
    <!-- 对话框边框（MainWindow.xaml:95，T-018 §2.1 第 4 项） -->
    <SolidColorBrush x:Key="DialogBorderBrush" Color="#1F000000" />
    <!-- LayoutThumbnail 的色块（T-018 §2.1 第 9 项），原来是白色系的半透明，浅色底下改用深色系 -->
    <SolidColorBrush x:Key="ThumbnailStrongBrush" Color="#8C1B1B1F" />
    <SolidColorBrush x:Key="ThumbnailWeakBrush" Color="#4D1B1B1F" />

    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <FontFamily x:Key="UiFont">Segoe UI</FontFamily>
    <!-- 覆盖 Fluent 控件的默认字体，保证中文不回退成方框 -->
    <FontFamily x:Key="ContentControlThemeFontFamily">Segoe UI, Microsoft YaHei UI</FontFamily>

    <!-- 让 Fluent 控件（CheckBox、ToggleSwitch 等）的强调色与 AccentColor 一致（T-018 同步更新，
         方案 §2.2 没有单独列出这几个键，但它们本来就是跟着 AccentColor 走的，不跟着改会和
         按钮、当前行的强调色不一样）。
         T-018 评审 M-1：浅色主题下，Fluent 控件（滑块已拖过部分、ToggleSwitch 打开时的底色、
         CheckBox 勾选后的底色、AccentButtonStyle 等）的 AccentFillColorDefault 取的是
         SystemAccentColorDark1～Dark3，不是 Light1～Light3——Light1～Light3 只在深色主题下
         才会用到。不加 Dark1～Dark3 的话，这些控件会退回用户 Windows 系统设置的强调色
         （可能是紫色、绿色），和我们的强调色对不上。Light1～Light3 保留（无害，浅色主题下
         用不到，以后万一切回深色主题还能用）。
         T-018 评审 M-2：这 7 个键和 AccentColor 一起从 #FF005A9E 加深到 #FF00477F
         （理由见上面 AccentColor 的注释）。 -->
    <Color x:Key="SystemAccentColor">#FF00477F</Color>
    <Color x:Key="SystemAccentColorLight1">#FF00477F</Color>
    <Color x:Key="SystemAccentColorLight2">#FF00477F</Color>
    <Color x:Key="SystemAccentColorLight3">#FF00477F</Color>
    <Color x:Key="SystemAccentColorDark1">#FF00477F</Color>
    <Color x:Key="SystemAccentColorDark2">#FF00477F</Color>
    <Color x:Key="SystemAccentColorDark3">#FF00477F</Color>

    <!-- 图标字体按钮：仅设外观属性，交互状态（悬停/按下）沿用 Fluent 原生 Button 模板 -->
    <Style x:Key="IconButton" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="8,5" />
        <Setter Property="CornerRadius" Value="5" />
    </Style>

    <!-- 播放/暂停主按钮，比其余传输键大一号。契约：以后的主按钮都用它 -->
    <Style x:Key="PrimaryIconButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
        <Setter Property="FontSize" Value="30" />
        <Setter Property="Padding" Value="6" />
    </Style>

    <!-- 设置面板底色（T-018 §2.2），§4 对比度 K-1、K-3 要在同一种背景上比较才公平 -->
    <SolidColorBrush x:Key="SettingsPanelBrush" Color="#F2FFFFFF" />

    <Style x:Key="SettingsSectionTitle" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <!-- 桌面歌词工具条按钮 -->
    <Style x:Key="LyricsToolButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="6,3" />
        <Setter Property="Foreground" Value="White" />
    </Style>

    <!-- T-018 补充（DEF-390-02）：系统控件默认的浅色样式和本程序配色不一致，统一成搜索框和
         设置面板的风格。这个字典在 App.xaml 里排在 XamlControlsResources 之后合并，同名键
         以这里为准（SystemAccentColor 用的也是这个机制），所以全局生效，不用改各个控件的 XAML。
         下拉框（曲库排序，整个程序只有这一处）：底色和搜索框一致，去掉系统默认的渐变边框 -->
    <StaticResource x:Key="ComboBoxBackground" ResourceKey="ControlFillBrush" />
    <StaticResource x:Key="ComboBoxBackgroundFocused" ResourceKey="ControlFillBrush" />
    <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#18000000" />
    <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="#1F000000" />
    <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="Transparent" />
    <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="Transparent" />
    <SolidColorBrush x:Key="ComboBoxBorderBrushPressed" Color="Transparent" />
    <SolidColorBrush x:Key="ComboBoxBorderBrushFocused" Color="Transparent" />
    <StaticResource x:Key="ComboBoxForeground" ResourceKey="TextBrush" />
    <StaticResource x:Key="ComboBoxForegroundPointerOver" ResourceKey="TextBrush" />
    <StaticResource x:Key="ComboBoxForegroundPressed" ResourceKey="TextBrush" />
    <StaticResource x:Key="ComboBoxDropDownGlyphForeground" ResourceKey="SecondaryTextBrush" />
    <!-- 展开的选项列表：改为不透明白底 + 细边框，和设置面板、右键菜单统一质感 -->
    <StaticResource x:Key="ComboBoxDropDownBackground" ResourceKey="PopupBrush" />
    <StaticResource x:Key="ComboBoxDropDownBorderBrush" ResourceKey="DialogBorderBrush" />
    <!-- 右键菜单（曲库、歌单详情、抽屉、「添加到歌单」子菜单、歌单列表「重命名/删除」等共用）：
         同样从系统默认的亚克力半透明改为不透明白底 + 细边框 -->
    <StaticResource x:Key="MenuFlyoutPresenterBackground" ResourceKey="PopupBrush" />
    <StaticResource x:Key="MenuFlyoutPresenterBorderBrush" ResourceKey="DialogBorderBrush" />

</ResourceDictionary>
