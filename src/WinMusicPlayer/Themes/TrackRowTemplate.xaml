<ResourceDictionary
    x:Class="WinMusicPlayer.Themes.TrackRowTemplate"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:MusicCore.Models"
    xmlns:views="using:WinMusicPlayer.Views">

    <!-- 曲库、歌单详情、播放列表三处列表共用的行模板（UI-1，T-001+T-008 v5 §4.5、T-007 v1 §2.6）。
         PlayIndicator、TitleText 两个命名元素留给 NowPlayingListView 用代码后置覆盖「当前播放」的
         视觉（播放图标 + 强调色文字）——这两项依赖的是播放列表里的下标，不是 Track 自身的属性，
         没法用 x:Bind 在这个与具体页面无关的模板里直接表达，默认保持「未播放」的样子。 -->
    <DataTemplate x:Key="TrackRowTemplate" x:DataType="models:Track">
        <Grid Margin="0,3"
              Opacity="{x:Bind views:ViewFormat.RowOpacity(IsAvailable), Mode=OneWay}"
              ToolTipService.ToolTip="{x:Bind views:ViewFormat.UnavailableTip(IsAvailable, Path), Mode=OneWay}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="PlayIndicator" Grid.Column="0"
                       FontFamily="{StaticResource IconFont}" Text="&#xE768;"
                       FontSize="11" Foreground="{StaticResource AccentBrush}"
                       VerticalAlignment="Center" Visibility="Collapsed" />

            <StackPanel Grid.Column="1" Margin="6,0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="TitleText" Text="{x:Bind Title, Mode=OneWay}"
                               Foreground="{StaticResource TextBrush}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="不可用" Margin="6,0,0,0"
                               FontSize="11" VerticalAlignment="Center"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               Visibility="{x:Bind views:ViewFormat.VisibleIfUnavailable(IsAvailable), Mode=OneWay}" />
                </StackPanel>
                <TextBlock Text="{x:Bind Subtitle, Mode=OneWay}"
                           FontSize="11"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           TextTrimming="CharacterEllipsis"
                           Visibility="{x:Bind views:ViewFormat.VisibleIfNotEmpty(Subtitle), Mode=OneWay}" />
            </StackPanel>

            <TextBlock Grid.Column="2" VerticalAlignment="Center"
                       Text="{x:Bind views:ViewFormat.Time(Duration), Mode=OneWay}"
                       FontSize="11"
                       Foreground="{StaticResource SecondaryTextBrush}" />
        </Grid>
    </DataTemplate>
</ResourceDictionary>
