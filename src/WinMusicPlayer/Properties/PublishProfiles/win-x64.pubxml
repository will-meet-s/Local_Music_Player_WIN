<?xml version="1.0" encoding="utf-8"?>
<!--
  单文件发布配置：产出一个可以随便拖到桌面的 exe。T-012a 验证这个组合能不能在
  非打包 WinUI 3 上跑起来——微软没有把它列为受支持的场景，结论以业主实测为准。

  为什么必须自带运行时并塞进单文件：
  - Platform=x64                 WinUI 3 不支持 Any CPU，构建会直接失败
  - SelfContained=true           目标机器不用装 .NET 桌面运行时，也不用装 Windows App Runtime
  - PublishSingleFile=true       托管 DLL 全部并进 exe
  - IncludeNativeLibrariesForSelfExtract=true
                                 Windows App SDK 依赖的原生库（DWrite、WebView2 loader 等），
                                 不加这项它们会散落在 exe 旁边，单文件就名不副实
  - IncludeAllContentForSelfExtract=true
                                 WinUI 3 运行时要从 exe 所在目录读 resources.pri、.xbf 这些
                                 内容文件，AppIcon.ico 也是。这项让它们和原生库一起打进 exe，
                                 首次运行时解压到 %TEMP%\.net\WinMusicPlayer\<hash>，
                                 之后 AppContext.BaseDirectory 就指向那个目录，T-001 读图标
                                 的代码不用改
  - EnableCompressionInSingleFile=true
                                 体积从约 180MB 压到 90MB 上下，代价是首次启动
                                 多花几百毫秒解压。嫌慢就把这行删掉
  - DebugType=none               不产出 pdb，发布目录里干净只有一个 exe

  用法：dotnet publish src\WinMusicPlayer -p:PublishProfile=win-x64
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>x64</Platform>
    <PublishProtocol>FileSystem</PublishProtocol>
    <PublishDir>..\..\publish\win-x64</PublishDir>

    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>false</PublishReadyToRun>
    <DebugType>none</DebugType>
  </PropertyGroup>
</Project>
