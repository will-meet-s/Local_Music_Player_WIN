<?xml version="1.0" encoding="utf-8"?>
<!--
  单文件发布配置：产出一个可以随便拖到桌面的 exe。

  为什么必须自带运行时并塞进单文件：
  - SelfContained=true          目标机器不用装 .NET 桌面运行时
  - PublishSingleFile=true      托管 DLL 全部并进 exe
  - IncludeNativeLibrariesForSelfExtract=true
                                WPF 依赖 PresentationNative、vcruntime 等原生库，
                                不加这项它们会散落在 exe 旁边，单文件就名不副实，
                                只把 exe 拖走照样起不来
  - EnableCompressionInSingleFile=true
                                体积从约 180MB 压到 90MB 上下，代价是首次启动
                                多花几百毫秒解压。嫌慢就把这行删掉
  - DebugType=none              不产出 pdb，发布目录里干净只有一个 exe

  用法：dotnet publish src\WinMusicPlayer -p:PublishProfile=win-x64

  为什么是 x64 而不是跟着本机 SDK 用 x86：x64 的运行时包本地已有缓存，发布
  不必再从 NuGet 拉一整套（x86 那套是全新的，首次发布慢得离谱）。要出 32 位版
  就把这个文件复制一份、两处 win-x64 改成 win-x86 —— ClickThrough 的 P/Invoke
  已按 IntPtr.Size 分派，两种位宽都兼容。
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <PublishProtocol>FileSystem</PublishProtocol>
    <PublishDir>..\..\publish\win-x64</PublishDir>

    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
  </PropertyGroup>
</Project>
