<Application x:Class="WinMusicPlayer.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:WinMusicPlayer.Converters"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>

            <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
            <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
            <conv:NullToVisibilityConverter x:Key="NullToVisibility" />
            <conv:ByteArrayToImageConverter x:Key="ByteArrayToImage" />
            <conv:SecondsToTimeConverter x:Key="SecondsToTime" />
            <conv:EnumToBoolConverter x:Key="EnumToBool" />
            <conv:PercentConverter x:Key="Percent" />

            <!-- 配色：深色为主，磨砂背景上文字对比度更稳 -->
            <Color x:Key="AccentColor">#FF5CA8FF</Color>
            <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
            <SolidColorBrush x:Key="TextBrush" Color="#FFF2F2F5" />
            <SolidColorBrush x:Key="SecondaryTextBrush" Color="#FFA0A0AC" />
            <SolidColorBrush x:Key="TertiaryTextBrush" Color="#FF70707A" />
            <SolidColorBrush x:Key="SeparatorBrush" Color="#22FFFFFF" />
            <SolidColorBrush x:Key="ControlFillBrush" Color="#18FFFFFF" />
            <SolidColorBrush x:Key="SidebarBrush" Color="#14FFFFFF" />

            <!--
              Windows 自带的图标字体，免去引入图标库。
              Segoe Fluent Icons 是 Win11 的字集，笔画更细、圆角更统一；
              Win10 上没有这个字体，WPF 会按逗号顺序回退到 MDL2。
            -->
            <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

            <!--
              正文字体。IconFont 只含私用区图标、没有 CJK 字形，凡是落在
              IconButton 内部或其 ToolTip 里的中文都会继承到它而渲染成乱码，
              所以这类文字必须显式指回这里。中文系统上 Segoe UI 会回退到
              微软雅黑，中英文都能正常显示。
            -->
            <FontFamily x:Key="UiFont">Segoe UI</FontFamily>

            <!-- ToolTip 会从宿主控件继承字体，图标按钮上的提示文字因此需要拨回正文字体 -->
            <Style TargetType="ToolTip">
                <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            </Style>

            <Style x:Key="IconButton" TargetType="Button">
                <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="8,5" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="5"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#26FFFFFF" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#40FFFFFF" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.35" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 播放/暂停主按钮，比其余传输键大一号 -->
            <Style x:Key="PrimaryIconButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
                <Setter Property="FontSize" Value="30" />
                <Setter Property="Padding" Value="6" />
            </Style>

            <Style x:Key="LyricsToolButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Padding" Value="6,3" />
                <Setter Property="Foreground" Value="White" />
            </Style>

            <!-- 下拉面板底色。半透明底色在磨砂窗口上会透出下层文字，这里用不透明深色 -->
            <SolidColorBrush x:Key="PopupBrush" Color="#FF23232A" />

            <!--
              ComboBox 必须整套重画：默认 Aero2 模板的按钮面和下拉面板都是写死的浅色，
              只改 Background 改不动它，而全局 TextBlock 前景是近白色 —— 于是白底白字。
            -->
            <Style TargetType="ComboBox">
                <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                <Setter Property="Padding" Value="9,5" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBox">
                            <Grid>
                                <!-- 整块面（含右侧箭头）由这个 ToggleButton 负责，点它开合下拉 -->
                                <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press"
                                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                                          RelativeSource={RelativeSource TemplatedParent}}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="Bd"
                                                    Background="{StaticResource ControlFillBrush}"
                                                    BorderBrush="{StaticResource SeparatorBrush}"
                                                    BorderThickness="1" CornerRadius="5">
                                                <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center"
                                                           Margin="0,0,9,0" FontSize="11"
                                                           FontFamily="{StaticResource IconFont}"
                                                           Foreground="{StaticResource SecondaryTextBrush}"
                                                           Text="&#xE70D;" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#26FFFFFF" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>

                                <!-- 当前选中项。IsHitTestVisible=False 让点击穿到上面的 ToggleButton -->
                                <ContentPresenter IsHitTestVisible="False"
                                                  Margin="{TemplateBinding Padding}"
                                                  HorizontalAlignment="Left" VerticalAlignment="Center"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" />

                                <Popup x:Name="PART_Popup" Placement="Bottom" Focusable="False"
                                       AllowsTransparency="True" PopupAnimation="Fade"
                                       IsOpen="{TemplateBinding IsDropDownOpen}">
                                    <Border Background="{StaticResource PopupBrush}"
                                            BorderBrush="{StaticResource SeparatorBrush}"
                                            BorderThickness="1" CornerRadius="5"
                                            Margin="0,3,0,0" Padding="3"
                                            MinWidth="{Binding ActualWidth,
                                                       RelativeSource={RelativeSource TemplatedParent}}"
                                            MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                        <ScrollViewer>
                                            <ItemsPresenter />
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.35" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="ComboBoxItem">
                <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                <Setter Property="Padding" Value="8,5" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBoxItem">
                            <Border x:Name="Bd" Background="Transparent" CornerRadius="4"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <!-- IsHighlighted 覆盖鼠标悬停与键盘上下移动两种情况 -->
                                <Trigger Property="IsHighlighted" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#26FFFFFF" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#335CA8FF" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
            </Style>

            <Style TargetType="CheckBox">
                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                <Setter Property="Margin" Value="0,4" />
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
