<Application
    x:Class="WinMusicPlayer.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:WinMusicPlayer.Converters"
    xmlns:themes="using:WinMusicPlayer.Themes"
    RequestedTheme="Light">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <!-- 放在 XamlControlsResources 之后：同名键（SystemAccentColor 等）以它为准 -->
                <ResourceDictionary Source="Themes/Colors.xaml" />
                <!-- 实例合并，不能用 Source=：TrackRowTemplate 里的 x:Bind 需要它的代码后置类
                     真正被构造、InitializeComponent() 跑过，否则运行时报找不到绑定连接（UI-1 坑 1） -->
                <themes:TrackRowTemplate />
            </ResourceDictionary.MergedDictionaries>

            <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
            <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
            <conv:NullToVisibilityConverter x:Key="NullToVisibility" />
            <conv:SecondsToTimeConverter x:Key="SecondsToTime" />
            <conv:EnumToBoolConverter x:Key="EnumToBool" />
            <conv:PercentConverter x:Key="Percent" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
